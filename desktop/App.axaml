<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Marschzeit.App" RequestedThemeVariant="Default">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="CardBg">#f1f3ee</SolidColorBrush>
          <SolidColorBrush x:Key="CardFg">#1a1a1a</SolidColorBrush>
          <SolidColorBrush x:Key="ProfileFill">#a6e88a</SolidColorBrush>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="CardBg">#1c1c1c</SolidColorBrush>
          <SolidColorBrush x:Key="CardFg">#eeeeee</SolidColorBrush>
          <SolidColorBrush x:Key="ProfileFill">#a6e88a</SolidColorBrush>
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </Application.Resources>
  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml" />
  </Application.Styles>
</Application>
